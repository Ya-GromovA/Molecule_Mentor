#:kivy 2.3.0
#:import Window kivy.core.window.Window


<HomeScreen>:
    canvas.before:
        Color:
            rgba: app.mm_bg
        Rectangle:
            pos: self.pos
            size: self.size

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(18)
        spacing: dp(8)

        Widget:
            size_hint_y: 0.06

        Label:
            text: "Molecule\nMentor"
            halign: "center"
            valign: "middle"
            color: (1, 1, 1, 1)
            font_name: "data/fonts/Roboto-Bold.ttf"
            font_size: min(dp(40), max(dp(24), root.width * 0.07))
            outline_width: 2
            outline_color: (0, 0, 0, 0.35)
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1]

        Widget:
            size_hint_y: 0.04

        MDBoxLayout:
            orientation: "vertical"
            size_hint: (None, None)

            width: min(root.width * 0.85, dp(800))

            height: self.minimum_height
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            spacing: dp(12)

            MDButton:
                style: "filled"
                size_hint_x: None
                width: self.parent.width
                size_hint_y: None
                height: max(dp(56), min(dp(72), root.height * 0.065))
                md_bg_color: (0.10, 0.78, 0.72, 1)
                radius: [dp(16)] * 4
                on_release: app.open_courses()

                canvas.after:
                    Color:
                        rgba: (1, 1, 1, 0.26)
                    Line:
                        rounded_rectangle: [self.x + dp(1), self.y + dp(1), self.width - dp(2), self.height - dp(2), dp(16)]
                        width: dp(1.3)

                MDButtonIcon:
                    icon: "book-open-page-variant"
                    theme_icon_color: "Custom"
                    icon_color: (1, 1, 1, 1)

                MDButtonText:
                    text: "Курсы (10 класс)"
                    theme_text_color: "Custom"
                    text_color: (1, 1, 1, 1)
                    font_style: "Title"
                    role: "medium"
                    bold: True

            MDButton:
                style: "filled"
                size_hint_x: None
                width: self.parent.width
                size_hint_y: None
                height: max(dp(56), min(dp(72), root.height * 0.065))
                md_bg_color: app.mm_surface2
                radius: [dp(16)] * 4
                on_release: app.open_molecules()

                MDButtonIcon:
                    icon: "atom"
                    theme_icon_color: "Custom"
                    icon_color: (1, 1, 1, 1)

                MDButtonText:
                    text: "Молекулы"
                    theme_text_color: "Custom"
                    text_color: (1, 1, 1, 1)
                    font_style: "Title"
                    role: "medium"
                    bold: True

            MDButton:
                style: "filled"
                size_hint_x: None
                width: self.parent.width
                size_hint_y: None
                height: max(dp(56), min(dp(72), root.height * 0.065))
                md_bg_color: app.mm_accent
                radius: [dp(16)] * 4
                on_release: app.open_reactions()

                MDButtonIcon:
                    icon: "flask-round-bottom"
                    theme_icon_color: "Custom"
                    icon_color: (1, 1, 1, 1)

                MDButtonText:
                    text: "Реакции"
                    theme_text_color: "Custom"
                    text_color: (1, 1, 1, 1)
                    font_style: "Title"
                    role: "medium"
                    bold: True

            MDButton:
                style: "filled"
                size_hint_x: None
                width: self.parent.width
                size_hint_y: None
                height: max(dp(56), min(dp(72), root.height * 0.065))
                md_bg_color: app.mm_button_color
                radius: [dp(16)] * 4
                on_release: app.open_reaction_editor()

                MDButtonIcon:
                    icon: "flask-plus"
                    theme_icon_color: "Custom"
                    icon_color: (1, 1, 1, 1)

                MDButtonText:
                    text: "Похимичим!"
                    theme_text_color: "Custom"
                    text_color: (1, 1, 1, 1)
                    font_style: "Title"
                    role: "medium"
                    bold: True

            MDButton:
                style: "filled"
                size_hint_x: None
                width: self.parent.width
                size_hint_y: None
                height: max(dp(56), min(dp(72), root.height * 0.065))
                md_bg_color: app.mm_surface
                radius: [dp(16)] * 4
                on_release: app.open_favorites()

                MDButtonIcon:
                    icon: "star"
                    theme_icon_color: "Custom"
                    icon_color: (1, 1, 1, 1)

                MDButtonText:
                    text: "Избранное"
                    theme_text_color: "Custom"
                    text_color: (1, 1, 1, 1)
                    font_style: "Title"
                    role: "medium"
                    bold: True

        Widget:
            size_hint_y: 0.08


<CoursesScreen>:
    MDBoxLayout:
        id: courses_container
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

<CourseTopicScreen>:
    MDBoxLayout:
        id: topic_container
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

<QuizScreen>:
    canvas.before:
        Color:
            rgba: app.mm_bg
        Rectangle:
            pos: self.pos
            size: self.size
    MDBoxLayout:
        id: quiz_container
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

<QuizSelectionScreen>:
    canvas.before:
        Color:
            rgba: app.mm_bg
        Rectangle:
            pos: self.pos
            size: self.size
    MDBoxLayout:
        id: quiz_selection_container
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

<StatsScreen>:
    canvas.before:
        Color:
            rgba: app.mm_bg
        Rectangle:
            pos: self.pos
            size: self.size
    MDBoxLayout:
        id: stats_container
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

<MoleculesScreen>:
    canvas.before:
        Color:
            rgba: app.mm_bg
        Rectangle:
            pos: self.pos
            size: self.size

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        MDTextField:
            id: search_field
            mode: "filled"
            size_hint_y: None
            height: dp(52)
            multiline: False

            on_text: root.on_search(self.text)

            fill_color_normal: 0.25, 0.26, 0.30, 1
            fill_color_focus: 0.30, 0.31, 0.35, 1

            text_color_normal: 1, 1, 1, 1
            text_color_focus: 1, 1, 1, 1

            line_color_normal: app.mm_text2
            line_color_focus: app.mm_accent

            MDTextFieldLeadingIcon:
                icon: "magnify"
                theme_icon_color: "Custom"
                icon_color: app.mm_text2

            MDTextFieldHintText:
                text: "Поиск"
                text_color_normal: app.mm_text2
                text_color_focus: app.mm_text2

        ScrollView:
            do_scroll_y: False
            do_scroll_x: True
            size_hint_y: None
            height: dp(42)
            bar_width: 0
            scroll_type: ["bars", "content"]

            MDBoxLayout:
                id: molecules_filter_row
                orientation: "horizontal"
                adaptive_width: True
                size_hint_y: None
                height: dp(42)
                spacing: dp(8)
                padding: 0, 0

                MDButton:
                    id: filter_all
                    style: "filled"
                    size_hint: None, None
                    width: dp(86)
                    height: dp(34)
                    radius: [dp(16)] * 4
                    on_release: root.set_filter("all")
                    MDButtonText:
                        text: "Все"

                MDButton:
                    id: filter_organic
                    style: "filled"
                    size_hint: None, None
                    width: dp(120)
                    height: dp(34)
                    radius: [dp(16)] * 4
                    on_release: root.set_filter("organic")
                    MDButtonText:
                        text: "Органика"

                MDButton:
                    id: filter_inorganic
                    style: "filled"
                    size_hint: None, None
                    width: dp(132)
                    height: dp(34)
                    radius: [dp(16)] * 4
                    on_release: root.set_filter("inorganic")
                    MDButtonText:
                        text: "Неорганика"

                MDButton:
                    id: filter_bio
                    style: "filled"
                    size_hint: None, None
                    width: dp(150)
                    height: dp(34)
                    radius: [dp(16)] * 4
                    on_release: root.set_filter("bio")
                    MDButtonText:
                        text: "Биомолекулы"

                MDButton:
                    id: filter_fav
                    style: "filled"
                    size_hint: None, None
                    width: dp(142)
                    height: dp(34)
                    radius: [dp(16)] * 4
                    on_release: root.set_filter("fav")
                    MDButtonText:
                        text: "Избранное"

        ScrollView:
            do_scroll_x: False
            bar_width: dp(6)

            MDList:
                id: molecules_list

<MoleculeViewerScreen>:
    canvas.before:
        Color:
            rgba: app.mm_bg
        Rectangle:
            pos: self.pos
            size: self.size

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(12)
        spacing: dp(10)

        FloatLayout:
            id: viewer_host
            size_hint: 1, 0.6

            BoxLayout:
                id: viewer_content_host
                orientation: "vertical"
                size_hint: 1, 1
                pos_hint: {"x": 0, "y": 0}

            MDBoxLayout:
                orientation: "vertical"
                size_hint: None, None
                width: dp(44)
                height: dp(44) * 3 + dp(8) * 2
                spacing: dp(8)
                pos_hint: {"right": 0.985, "top": 0.985}

                MDIconButton:
                    icon: "palette-outline"
                    style: "filled"
                    md_bg_color: app.mm_surface2
                    theme_icon_color: "Custom"
                    icon_color: app.mm_text
                    on_release: root.action_toggle_style()

                MDIconButton:
                    icon: "link-variant"
                    style: "filled"
                    md_bg_color: app.mm_surface2
                    theme_icon_color: "Custom"
                    icon_color: app.mm_text
                    on_release: root.action_toggle_bonds()

                MDIconButton:
                    icon: root.fav_icon
                    style: "filled"
                    md_bg_color: app.mm_surface2
                    theme_icon_color: "Custom"
                    icon_color: app.mm_text
                    on_release: root.action_toggle_favorite()

        BoxLayout:
            id: description_card
            orientation: "vertical"
            padding: dp(14)
            size_hint: 1, None
            height: dp(80)
            canvas.before:
                Color:
                    rgba: (0.06, 0.07, 0.12, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [18, 18, 18, 18]

            ScrollView:
                do_scroll_x: False

                Label:
                    id: description_label
                    text: ""
                    color: (1, 1, 1, 1)
                    font_size: dp(14)
                    halign: "left"
                    valign: "top"
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1]

        MDButton:
            style: "filled"
            size_hint: 1, None
            height: dp(48)
            md_bg_color: app.mm_accent
            on_release: root.open_editor()

            MDButtonText:
                text: "Редактировать молекулу"
                theme_text_color: "Custom"
                text_color: (0, 0, 0, 1)

<MoleculeEditorScreen>:
    canvas.before:
        Color:
            rgba: app.mm_bg
        Rectangle:
            pos: self.pos
            size: self.size

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(2)
        spacing: dp(1)

        BoxLayout:
            size_hint: 1, None
            height: dp(30)
            spacing: dp(6)

            MDLabel:
                id: message_label
                text: ""
                halign: "left"
                valign: "middle"
                theme_text_color: "Custom"
                text_color: (0.3, 0.9, 0.5, 1)
                font_size: dp(11)
                bold: True
                size_hint_x: 1
                text_size: self.width, self.height
                shorten: True
                shorten_from: "right"
                max_lines: 1

            MDButton:
                id: run_reaction_btn
                style: "filled"
                size_hint: None, None
                size: dp(152), dp(22)
                md_bg_color: (0.2, 0.8, 0.4, 1)
                opacity: 0
                disabled: True
                on_release: root.run_reaction()
                MDButtonIcon:
                    icon: "play"
                    theme_icon_color: "Custom"
                    icon_color: (0, 0, 0, 1)
                MDButtonText:
                    text: "Запустить"
                    theme_text_color: "Custom"
                    text_color: (0, 0, 0, 1)
                    font_size: dp(10)

        FloatLayout:
            size_hint: 1, 1

            BoxLayout:
                id: editor_host
                orientation: "vertical"
                size_hint: 1, 1
                pos_hint: {"x": 0, "y": 0}



        BoxLayout:
            orientation: "vertical"
            size_hint: 1, None
            height: dp(104)
            spacing: dp(3)
            padding: dp(2), dp(2)

            BoxLayout:
                size_hint: 1, None
                height: dp(34)
                padding: dp(6), dp(2)
                canvas.before:
                    Color:
                        rgba: (0.06, 0.07, 0.12, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [4, 4, 4, 4]

                MDLabel:
                    id: info_label
                    text: ""
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: (0.6, 0.6, 0.7, 1)
                    font_size: min(dp(6), max(dp(4), self.width * 0.028))
                    text_size: self.width - dp(24), None
                    valign: "middle"
                    shorten: False
                    max_lines: 2

            BoxLayout:
                orientation: "horizontal"
                size_hint: 1, None
                height: dp(28)
                spacing: dp(3)
                padding: 0, dp(2), 0, dp(2)

                MDLabel:
                    id: temp_label
                    text: "25 C"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: app.mm_text
                    font_size: dp(10)
                    size_hint_x: None
                    width: dp(36)

                MDSlider:
                    id: temp_slider
                    min: -200
                    max: 500
                    value: 25
                    step: 10
                    size_hint_x: 1
                    on_value: root.on_temperature_change(self.value)

                MDIconButton:
                    icon: "snowflake"
                    style: "filled"
                    md_bg_color: (0.2, 0.5, 0.9, 1)
                    theme_icon_color: "Custom"
                    icon_color: (1, 1, 1, 1)
                    size_hint: None, None
                    size: dp(28), dp(24)
                    on_release: root.apply_cooling()

                MDIconButton:
                    icon: "fire"
                    style: "filled"
                    md_bg_color: (0.9, 0.3, 0.2, 1)
                    theme_icon_color: "Custom"
                    icon_color: (1, 1, 1, 1)
                    size_hint: None, None
                    size: dp(28), dp(24)
                    on_release: root.apply_heat()

            MDGridLayout:
                cols: 2
                rows: 2
                size_hint: 1, None
                height: dp(68)
                spacing: dp(4)
                row_force_default: True
                row_default_height: dp(30)
                col_force_default: False

                MDButton:
                    style: "tonal"
                    size_hint: 1, None
                    height: dp(30)
                    on_release: root.toggle_bond_mode()
                    MDButtonText:
                        id: mode_label
                        text: "Связать"
                        font_size: dp(9)

                MDButton:
                    id: reagent_btn
                    style: "outlined"
                    size_hint: 1, None
                    height: dp(30)
                    on_release: root.show_reagent_menu()
                    MDButtonText:
                        text: "+ Реагент"
                        font_size: dp(9)

                MDButton:
                    style: "outlined"
                    size_hint: 1, None
                    height: dp(30)
                    on_release: root.reset_molecule()
                    MDButtonText:
                        text: "Сброс"
                        font_size: dp(9)

                MDButton:
                    style: "filled"
                    size_hint: 1, None
                    height: dp(30)
                    md_bg_color: app.mm_primary
                    on_release: root.identify_molecule()
                    MDButtonText:
                        text: "ИИ"
                        font_size: dp(9)
                        theme_text_color: "Custom"
                        text_color: (0, 0, 0, 1)

<TheoryScreen>:
    MDBoxLayout:
        id: theory_container
        orientation: "vertical"

<ReactionsScreen>:
    MDBoxLayout:
        id: reactions_container
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

<ReactionViewerScreen>:
    MDBoxLayout:
        id: reaction_viewer_container
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

<ReactionEditorScreen>:
    canvas.before:
        Color:
            rgba: app.mm_bg
        Rectangle:
            pos: self.pos
            size: self.size

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(4)
        spacing: dp(2)

        MDLabel:
            id: message_label
            text: "Выберите вещества для смешивания"
            halign: "center"
            size_hint: 1, None
            height: dp(20)
            theme_text_color: "Custom"
            text_color: app.mm_accent
            font_size: sp(13)
            bold: True

        FloatLayout:
            size_hint: 1, 1

            BoxLayout:
                id: editor_host
                orientation: "vertical"
                size_hint: 1, 0.96
                pos_hint: {"x": 0, "top": 1}

            MDButton:
                id: mix_btn
                style: "filled"
                size_hint: None, None
                width: min(dp(120), root.width * 0.32)
                height: dp(22)
                pos_hint: {"x": 0.02, "top": 0.98}
                md_bg_color: app.mm_accent
                on_release: root.run_reaction()
                MDButtonText:
                    text: "Смешать!"
                    font_size: min(sp(12), max(sp(9), root.width * 0.026))
                    theme_text_color: "Custom"
                    text_color: (1, 1, 1, 1)
                    bold: True

            MDButton:
                id: reset_btn
                style: "filled"
                size_hint: None, None
                width: min(dp(120), root.width * 0.32)
                height: dp(22)
                pos_hint: {"right": 0.98, "top": 0.98}
                md_bg_color: (0.2, 0.22, 0.28, 1)
                on_release: root.reset_editor()
                MDButtonText:
                    text: "Сброс"
                    font_size: min(sp(11), max(sp(8), root.width * 0.024))
                    theme_text_color: "Custom"
                    text_color: app.mm_text

        Widget:
            size_hint: 1, None
            height: dp(6)

        MDBoxLayout:
            orientation: "horizontal"
            size_hint: 1, None
            height: dp(26)
            spacing: dp(4)
            padding: [dp(4), dp(1)]

            MDIconButton:
                icon: "snowflake"
                theme_icon_color: "Custom"
                icon_color: (0.35, 0.75, 1, 1)
                size_hint_x: None
                width: dp(26)
                md_bg_color: (0, 0, 0, 0)
                on_release: None

            MDSlider:
                id: temp_slider
                min: -200
                max: 500
                value: 25
                step: 10
                size_hint_x: 1
                on_value: root.on_temperature_change(self.value)

            MDIconButton:
                icon: "fire"
                theme_icon_color: "Custom"
                icon_color: (1, 0.55, 0.2, 1)
                size_hint_x: None
                width: dp(26)
                md_bg_color: (0, 0, 0, 0)
                on_release: None

            MDLabel:
                id: temp_label
                text: "25 C"
                halign: "center"
                theme_text_color: "Custom"
                text_color: app.mm_text
                font_size: min(sp(11), max(sp(9), self.width * 0.3))
                size_hint_x: None
                width: dp(42)

        Widget:
            size_hint: 1, None
            height: dp(4)

        BoxLayout:
            size_hint: 1, None
            height: dp(36)
            padding: [dp(6), dp(2)]
            canvas.before:
                Color:
                    rgba: (0.06, 0.07, 0.12, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [4, 4, 4, 4]
            MDLabel:
                id: info_label
                text: ""
                halign: "center"
                valign: "middle"
                text_size: self.size
                theme_text_color: "Custom"
                text_color: (0.6, 0.6, 0.7, 1)
                font_size: sp(10)

        MDBoxLayout:
            orientation: "vertical"
            size_hint: 1, None
            height: dp(96)
            padding: dp(2)
            spacing: dp(4)

            MDBoxLayout:
                orientation: "vertical"
                size_hint: 1, None
                height: dp(72)
                spacing: dp(6)

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint: 1, None
                    height: dp(30)
                    spacing: dp(4)

                    MDButton:
                        id: btn_acid
                        style: "filled"
                        size_hint: 1, None
                        height: dp(24)
                        md_bg_color: (0.15, 0.18, 0.25, 1)
                        on_release: root.show_substance_menu("acid")
                        MDButtonText:
                            text: "Кислоты"
                            font_size: min(sp(11), max(sp(7), root.width * 0.02))
                            theme_text_color: "Custom"
                            text_color: app.mm_text

                    MDButton:
                        id: btn_base
                        style: "filled"
                        size_hint: 1, None
                        height: dp(24)
                        md_bg_color: (0.15, 0.18, 0.25, 1)
                        on_release: root.show_substance_menu("base")
                        MDButtonText:
                            text: "Основания"
                            font_size: min(sp(11), max(sp(7), root.width * 0.02))
                            theme_text_color: "Custom"
                            text_color: app.mm_text

                    MDButton:
                        id: btn_metal
                        style: "filled"
                        size_hint: 1, None
                        height: dp(24)
                        md_bg_color: (0.15, 0.18, 0.25, 1)
                        on_release: root.show_substance_menu("metal")
                        MDButtonText:
                            text: "Металлы"
                            font_size: min(sp(11), max(sp(7), root.width * 0.02))
                            theme_text_color: "Custom"
                            text_color: app.mm_text

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint: 1, None
                    height: dp(30)
                    spacing: dp(4)

                    MDButton:
                        id: btn_other
                        style: "filled"
                        size_hint: 1, None
                        height: dp(24)
                        md_bg_color: (0.15, 0.18, 0.25, 1)
                        on_release: root.show_substance_menu("other")
                        MDButtonText:
                            text: "Другие"
                            font_size: min(sp(11), max(sp(7), root.width * 0.02))
                            theme_text_color: "Custom"
                            text_color: app.mm_text

                    MDButton:
                        id: btn_organic
                        style: "filled"
                        size_hint: 1, None
                        height: dp(24)
                        md_bg_color: (0.15, 0.18, 0.25, 1)
                        on_release: root.show_substance_menu("organic")
                        MDButtonText:
                            text: "Органические"
                            font_size: min(sp(11), max(sp(7), root.width * 0.02))
                            theme_text_color: "Custom"
                            text_color: app.mm_text

                    Widget:
                        size_hint: 1, 1

            Widget:
                size_hint: 1, None
                height: dp(0)

<AIAssistantScreen>:
    MDBoxLayout:
        id: ai_container
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)



<MMRoot@FloatLayout>:
    canvas.before:
        Color:
            rgba: app.mm_bg
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        size_hint: 1, 1

        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(12), 0, dp(0), 0
            spacing: dp(10)
            canvas.before:
                Color:
                    rgba: app.mm_surface
                Rectangle:
                    pos: self.pos
                    size: self.size

            AnchorLayout:
                size_hint_x: None
                width: dp(96)
                anchor_x: "left"
                anchor_y: "center"

                MDButton:
                    id: back_btn
                    size_hint: None, None
                    width: dp(96)
                    height: dp(32)
                    style: "text"
                    opacity: 1 if app.back_visible else 0
                    disabled: not app.back_visible
                    on_release: app.go_back()
                    MDButtonText:
                        text: "Назад"
                        theme_text_color: "Custom"
                        text_color: app.mm_text

            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"
                size_hint_x: 1

                MDLabel:
                    text: app.top_title
                    halign: "center"
                    valign: "middle"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: (0.70, 0.65, 0.85, 1) if app.top_title == "Главная" else app.mm_text

                    max_lines: 2
                    shorten: False
                    text_size: (self.width, None)

                    font_size: min(dp(34), max(dp(16), root.width * 0.03))

            BoxLayout:
                orientation: "horizontal"
                size_hint_x: None
                # Делаем правый блок той же ширины, что и левый,
                # чтобы заголовок оказался строго по центру TopBar.
                width: dp(96)
                size_hint_y: None
                height: dp(60)
                padding: 0, dp(6), 0, 0
                spacing: 0
                pos_hint: {"center_y": 0.5}

                AnchorLayout:
                    anchor_x: "right"
                    anchor_y: "center"
                    size_hint: 1, 1

                    MDCard:
                        size_hint: None, None
                        width: dp(32)
                        height: dp(32)
                        radius: [dp(16)] * 4
                        theme_bg_color: "Custom"
                        md_bg_color: (0, 0, 0, 0)

                        canvas.after:
                            Color:
                                rgba:
                                    (0.20, 0.85, 0.35, 1) if app.ai_status_phase == "online" \
                                    else (0.15, 0.65, 0.95, 1) if app.ai_status_phase == "offline" \
                                    else (0.70, 0.70, 0.75, 1) if app.ai_status_phase == "checking" \
                                    else (0.55, 0.55, 0.60, 1)
                            Line:
                                rounded_rectangle: [self.x + dp(1), self.y + dp(1), self.width - dp(2), self.height - dp(2), dp(16)]
                                width: dp(1.6)

                        AnchorLayout:
                            anchor_x: "center"
                            anchor_y: "center"

                            MDIconButton:
                                id: ai_info_icon
                                icon: "information-outline"
                                theme_icon_color: "Custom"
                                icon_color: app.mm_text
                                icon_size: dp(18)
                                size_hint: None, None
                                width: dp(32)
                                height: dp(32)
                                on_release: app.show_ai_info()

        ScreenManager:
            id: sm

        BoxLayout:
            size_hint_y: None
            height: dp(44)
            padding: dp(8), dp(4)
            canvas.before:
                Color:
                    rgba: app.mm_surface
                Rectangle:
                    pos: self.pos
                    size: self.size

            MDIconButton:
                icon: "home"
                theme_icon_color: "Custom"
                icon_color: app.mm_text
                opacity: 0 if root.ids.sm.current == "home" else 1
                disabled: True if root.ids.sm.current == "home" else False
                on_release: app.open_home()

            Widget:

    MDFabButton:
        icon: "robot-outline"
        style: "small"
        md_bg_color: app.mm_primary
        theme_icon_color: "Custom"
        icon_color: (0, 0, 0, 1)
        pos_hint: {"right": 0.97, "y": 0.008}
        on_release: app.open_ai_assistant()


MMRoot:
