#:kivy 2.3.1
#:import Window kivy.core.window.Window

# ===== Screen templates (single KV file) =====

<HomeScreen>:
    canvas.before:
        # Единый мягкий лавандовый фон (как на экране молекул)
        Color:
            rgba: app.mm_bg
        Rectangle:
            pos: self.pos
            size: self.size

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(24)
        spacing: dp(10)

        # top spacer
        Widget:
            size_hint_y: 0.12

        # Title higher & bigger
        MDLabel:
            text: "Molecule Mentor"
            halign: "center"
            theme_text_color: "Custom"
            text_color: app.mm_text
            bold: True
            adaptive_height: True
            font_size: max(dp(70), min(dp(110), root.height * 0.10))

        Widget:
            size_hint_y: 0.04

        # Center menu: wider + centered with rounded buttons
        MDBoxLayout:
            orientation: "vertical"
            size_hint: (None, None)

            # Шире для центрирования
            width: min(root.width * 0.85, dp(800))

            height: self.minimum_height
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            spacing: dp(20)

            # Button 1: Курсы
            MDButton:
                style: "filled"
                size_hint_x: None
                width: self.parent.width
                size_hint_y: None
                height: max(dp(70), min(dp(100), root.height * 0.08))
                md_bg_color: app.mm_primary
                radius: [dp(16)] * 4
                on_release: app.open_courses()

                MDButtonIcon:
                    icon: "book-open-page-variant"
                    theme_icon_color: "Custom"
                    icon_color: (1, 1, 1, 1)
                
                MDButtonText:
                    text: "Курсы (10 класс)"
                    theme_text_color: "Custom"
                    text_color: (1, 1, 1, 1)
                    font_style: "Title"
                    role: "medium"
                    bold: True

            # Button 2: Молекулы
            MDButton:
                style: "filled"
                size_hint_x: None
                width: self.parent.width
                size_hint_y: None
                height: max(dp(70), min(dp(100), root.height * 0.08))
                md_bg_color: app.mm_surface2
                radius: [dp(16)] * 4
                on_release: app.open_molecules()

                MDButtonIcon:
                    icon: "atom"
                    theme_icon_color: "Custom"
                    icon_color: (1, 1, 1, 1)
                
                MDButtonText:
                    text: "Молекулы"
                    theme_text_color: "Custom"
                    text_color: (1, 1, 1, 1)
                    font_style: "Title"
                    role: "medium"
                    bold: True

            # Button 3: Реакции
            MDButton:
                style: "filled"
                size_hint_x: None
                width: self.parent.width
                size_hint_y: None
                height: max(dp(70), min(dp(100), root.height * 0.08))
                md_bg_color: app.mm_accent
                radius: [dp(16)] * 4
                on_release: app.open_reactions()

                MDButtonIcon:
                    icon: "flask-round-bottom"
                    theme_icon_color: "Custom"
                    icon_color: (1, 1, 1, 1)
                
                MDButtonText:
                    text: "Реакции"
                    theme_text_color: "Custom"
                    text_color: (1, 1, 1, 1)
                    font_style: "Title"
                    role: "medium"
                    bold: True

            # Button 4: Похимичим!
            MDButton:
                style: "filled"
                size_hint_x: None
                width: self.parent.width
                size_hint_y: None
                height: max(dp(70), min(dp(100), root.height * 0.08))
                md_bg_color: app.mm_button_color
                radius: [dp(16)] * 4
                on_release: app.open_reaction_editor()

                MDButtonIcon:
                    icon: "flask-plus"
                    theme_icon_color: "Custom"
                    icon_color: (1, 1, 1, 1)
                
                MDButtonText:
                    text: "Похимичим!"
                    theme_text_color: "Custom"
                    text_color: (1, 1, 1, 1)
                    font_style: "Title"
                    role: "medium"
                    bold: True

        # bottom spacer
        Widget:
            size_hint_y: 0.15


<CoursesScreen>:
    MDBoxLayout:
        id: courses_container
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

<CourseTopicScreen>:
    MDBoxLayout:
        id: topic_container
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

<QuizScreen>:
    MDBoxLayout:
        id: quiz_container
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

<MoleculesScreen>:
    canvas.before:
        Color:
            rgba: app.mm_bg
        Rectangle:
            pos: self.pos
            size: self.size
            
    MDBoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        # Поиск
        MDTextField:
            id: search_field
            mode: "filled"
            size_hint_y: None
            height: dp(52)
            multiline: False

            on_text: root.on_search(self.text)

            # Светлый фон поля ввода
            fill_color_normal: 0.25, 0.26, 0.30, 1
            fill_color_focus: 0.30, 0.31, 0.35, 1
            
            # Белый текст ввода
            text_color_normal: 1, 1, 1, 1
            text_color_focus: 1, 1, 1, 1
            
            # Цвет линии снизу
            line_color_normal: app.mm_text2
            line_color_focus: app.mm_accent

            MDTextFieldLeadingIcon:
                icon: "magnify"
                theme_icon_color: "Custom"
                icon_color: app.mm_text2

            MDTextFieldHintText:
                text: "Поиск"
                text_color_normal: app.mm_text2
                text_color_focus: app.mm_text2

        # Список
        ScrollView:
            do_scroll_x: False
            bar_width: dp(6)

            MDList:
                id: molecules_list
                
<MoleculeViewerScreen>:
    canvas.before:
        Color:
            rgba: app.mm_bg
        Rectangle:
            pos: self.pos
            size: self.size

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(12)
        spacing: dp(10)

        # 3D-виджет
        BoxLayout:
            id: viewer_host
            orientation: "vertical"
            size_hint: 1, 0.6

        # Описание молекулы
        BoxLayout:
            id: description_card
            orientation: "vertical"
            padding: dp(14)
            size_hint: 1, None
            height: dp(80)
            canvas.before:
                Color:
                    rgba: (0.06, 0.07, 0.12, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [18, 18, 18, 18]

            ScrollView:
                do_scroll_x: False

                Label:
                    id: description_label
                    text: ""
                    color: (1, 1, 1, 1)
                    font_size: dp(14)
                    halign: "left"
                    valign: "top"
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1]

        # Кнопка редактирования
        MDButton:
            style: "filled"
            size_hint: 1, None
            height: dp(48)
            md_bg_color: app.mm_accent
            on_release: root.open_editor()
            
            MDButtonText:
                text: "Редактировать молекулу"
                theme_text_color: "Custom"
                text_color: (0, 0, 0, 1)

<MoleculeEditorScreen>:
    canvas.before:
        Color:
            rgba: app.mm_bg
        Rectangle:
            pos: self.pos
            size: self.size

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(4)
        spacing: dp(2)

        # Сообщение (зелёные надписи) — наверху над молекулой
        MDLabel:
            id: message_label
            text: ""
            halign: "center"
            theme_text_color: "Custom"
            text_color: (0.3, 0.9, 0.5, 1)
            font_size: dp(11)
            bold: True
            size_hint_y: None
            height: dp(16)

        # 3D-редактор (основная область)
        BoxLayout:
            id: editor_host
            orientation: "vertical"
            size_hint: 1, 1

        # Кнопка "Запустить процесс" (скрыта по умолчанию, появляется после добавления реагента)
        MDButton:
            id: run_reaction_btn
            style: "filled"
            size_hint: 1, None
            height: dp(0)
            md_bg_color: (0.2, 0.8, 0.4, 1)
            opacity: 0
            disabled: True
            on_release: root.run_reaction()
            MDButtonIcon:
                icon: "play"
                theme_icon_color: "Custom"
                icon_color: (0, 0, 0, 1)
            MDButtonText:
                text: "Запустить процесс"
                theme_text_color: "Custom"
                text_color: (0, 0, 0, 1)
                font_size: dp(11)

        # Нижняя панель
        BoxLayout:
            orientation: "vertical"
            size_hint: 1, None
            height: dp(90)
            spacing: dp(3)
            padding: dp(2), dp(2)

            # Строка 1: Инфо (атомы, связи, формула)
            BoxLayout:
                size_hint: 1, None
                height: dp(16)
                padding: dp(4), dp(1)
                canvas.before:
                    Color:
                        rgba: (0.06, 0.07, 0.12, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [4, 4, 4, 4]

                MDLabel:
                    id: info_label
                    text: ""
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: (0.6, 0.6, 0.7, 1)
                    font_size: dp(8)

            # Строка 2: Температура
            BoxLayout:
                orientation: "horizontal"
                size_hint: 1, None
                height: dp(28)
                spacing: dp(3)
                padding: 0, dp(2), 0, dp(2)

                MDLabel:
                    id: temp_label
                    text: "25°C"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: app.mm_text
                    font_size: dp(10)
                    size_hint_x: None
                    width: dp(36)

                MDSlider:
                    id: temp_slider
                    min: -200
                    max: 500
                    value: 25
                    step: 10
                    size_hint_x: 1
                    on_value: root.on_temperature_change(self.value)

                MDIconButton:
                    icon: "snowflake"
                    style: "filled"
                    md_bg_color: (0.2, 0.5, 0.9, 1)
                    theme_icon_color: "Custom"
                    icon_color: (1, 1, 1, 1)
                    size_hint: None, None
                    size: dp(28), dp(24)
                    on_release: root.apply_cooling()

                MDIconButton:
                    icon: "fire"
                    style: "filled"
                    md_bg_color: (0.9, 0.3, 0.2, 1)
                    theme_icon_color: "Custom"
                    icon_color: (1, 1, 1, 1)
                    size_hint: None, None
                    size: dp(28), dp(24)
                    on_release: root.apply_heat()

            # Строка 3: Кнопки управления (масштабируемые по ширине)
            BoxLayout:
                orientation: "horizontal"
                size_hint: 1, None
                height: dp(32)
                spacing: dp(4)

                MDButton:
                    style: "tonal"
                    size_hint_x: 0.22
                    on_release: root.toggle_bond_mode()
                    MDButtonText:
                        id: mode_label
                        text: "Связать"
                        font_size: dp(9)

                MDButton:
                    id: reagent_btn
                    style: "outlined"
                    size_hint_x: 0.28
                    on_release: root.show_reagent_menu()
                    MDButtonText:
                        text: "+ Реагент"
                        font_size: dp(9)

                MDButton:
                    style: "outlined"
                    size_hint_x: 0.22
                    on_release: root.reset_molecule()
                    MDButtonText:
                        text: "Сброс"
                        font_size: dp(9)

                MDButton:
                    style: "filled"
                    size_hint_x: 0.18
                    md_bg_color: app.mm_primary
                    on_release: root.identify_molecule()
                    MDButtonText:
                        text: "ИИ"
                        font_size: dp(9)
                        theme_text_color: "Custom"
                        text_color: (0, 0, 0, 1)

<TheoryScreen>:
    MDBoxLayout:
        id: theory_container
        orientation: "vertical"

<ReactionsScreen>:
    MDBoxLayout:
        id: reactions_container
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)
        
<ReactionViewerScreen>:
    # контент строится из Python, чтобы не ловить несовместимости виджетов KivyMD 2.x в KV
    MDBoxLayout:
        id: reaction_viewer_container
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

<ReactionEditorScreen>:
    canvas.before:
        Color:
            rgba: app.mm_bg
        Rectangle:
            pos: self.pos
            size: self.size

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(4)
        spacing: dp(2)

        # Заголовок-подсказка над 3D областью
        MDLabel:
            id: message_label
            text: "Выберите вещества для смешивания"
            halign: "center"
            size_hint: 1, None
            height: dp(24)
            theme_text_color: "Custom"
            text_color: app.mm_accent
            font_size: sp(13)
            bold: True

        # 3D область
        BoxLayout:
            id: editor_host
            orientation: "vertical"
            size_hint: 1, 1

        # Инфо о веществах (компактно)
        BoxLayout:
            size_hint: 1, None
            height: dp(18)
            padding: [dp(4), 0]
            canvas.before:
                Color:
                    rgba: (0.06, 0.07, 0.12, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [4, 4, 4, 4]
            MDLabel:
                id: info_label
                text: ""
                halign: "center"
                theme_text_color: "Custom"
                text_color: (0.6, 0.6, 0.7, 1)
                font_size: sp(10)

        # Панель управления (компактная)
        MDBoxLayout:
            orientation: "vertical"
            size_hint: 1, None
            height: dp(115)
            padding: dp(2)
            spacing: dp(2)

            # Температура (компактный слайдер)
            MDBoxLayout:
                orientation: "horizontal"
                size_hint: 1, None
                height: dp(26)
                spacing: dp(2)

                MDLabel:
                    id: temp_label
                    text: "25°C"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: app.mm_text
                    font_size: sp(10)
                    size_hint_x: None
                    width: dp(40)

                MDSlider:
                    id: temp_slider
                    min: -200
                    max: 500
                    value: 25
                    step: 10
                    size_hint_x: 1
                    on_value: root.on_temperature_change(self.value)

            # Кнопки выбора веществ (2 ряда для телефона)
            MDBoxLayout:
                orientation: "horizontal"
                size_hint: 1, None
                height: dp(28)
                spacing: dp(2)

                MDButton:
                    id: btn_acid
                    style: "outlined"
                    size_hint: 1, 1
                    on_release: root.show_substance_menu("acid")
                    MDButtonText:
                        text: "Кисл."
                        font_size: sp(9)

                MDButton:
                    id: btn_base
                    style: "outlined"
                    size_hint: 1, 1
                    on_release: root.show_substance_menu("base")
                    MDButtonText:
                        text: "Осн."
                        font_size: sp(9)

                MDButton:
                    id: btn_metal
                    style: "outlined"
                    size_hint: 1, 1
                    on_release: root.show_substance_menu("metal")
                    MDButtonText:
                        text: "Мет."
                        font_size: sp(9)

                MDButton:
                    id: btn_other
                    style: "outlined"
                    size_hint: 1, 1
                    on_release: root.show_substance_menu("other")
                    MDButtonText:
                        text: "Др."
                        font_size: sp(9)

                MDButton:
                    id: btn_organic
                    style: "outlined"
                    size_hint: 1, 1
                    on_release: root.show_substance_menu("organic")
                    MDButtonText:
                        text: "Орг."
                        font_size: sp(9)

            # Кнопки действий
            MDBoxLayout:
                orientation: "horizontal"
                size_hint: 1, None
                height: dp(32)
                spacing: dp(4)

                MDButton:
                    style: "filled"
                    size_hint: 2, 1
                    md_bg_color: app.mm_accent
                    on_release: root.run_reaction()
                    MDButtonText:
                        text: "Смешать!"
                        font_size: sp(12)
                        theme_text_color: "Custom"
                        text_color: (1, 1, 1, 1)
                        bold: True

                MDButton:
                    style: "outlined"
                    size_hint: 1, 1
                    on_release: root.reset_editor()
                    MDButtonText:
                        text: "Сброс"
                        font_size: sp(10)

                MDButton:
                    style: "tonal"
                    size_hint: 1, 1
                    on_release: app.go_back()
                    MDButtonText:
                        text: "Назад"
                        font_size: sp(10)

<AIAssistantScreen>:
    MDBoxLayout:
        id: ai_container
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)


# ===== Root layout =====

<MMRoot@FloatLayout>:
    canvas.before:
        Color:
            rgba: app.mm_bg
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        size_hint: 1, 1

        # ===== Top bar =====
                # ===== Top bar =====
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(12), 0
            spacing: dp(10)
            canvas.before:
                Color:
                    rgba: app.mm_surface
                Rectangle:
                    pos: self.pos
                    size: self.size

            # --- Left: Back (fixed width) ---
            MDButton:
                id: back_btn
                size_hint_x: None
                width: dp(96)
                style: "text"
                opacity: 1 if app.back_visible else 0
                disabled: not app.back_visible
                on_release: app.go_back()
                MDButtonText:
                    text: "Назад"
                    theme_text_color: "Custom"
                    text_color: app.mm_text

            # --- Center: title (takes all remaining space) ---
            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"
                size_hint_x: 1

                MDLabel:
                    text: app.top_title
                    halign: "center"
                    valign: "middle"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: (0.70, 0.65, 0.85, 1) if app.top_title == "Главная" else app.mm_text

                    # ВАЖНО: не переносим, не режем
                    max_lines: 2
                    shorten: False
                    text_size: (self.width, None)

                    # Защита от узких: размер зависит от доступной ширины центра
                    # - на широких окнах растёт
                    # - на узких уменьшается, чтобы "Главная" влезла полностью
                    font_size: min(dp(34), max(dp(16), root.width * 0.03))

            # --- Right: status + info (fixed width) ---
            BoxLayout:
                orientation: "horizontal"
                size_hint_x: None
                width: min(dp(180), root.width * 0.28)
                size_hint_y: None
                height: dp(60)
                padding: 0, dp(6), 0, 0
                spacing: dp(6)
                pos_hint: {"center_y": 0.5}

                MDLabel:
                    text: "ONLINE" if app.ai_status == "ONLINE" else "OFFLINE" if app.ai_status == "OFFLINE" else "ИИ недоступен"
                    halign: "right"
                    valign: "middle"
                    theme_text_color: "Custom"
                    text_color:
                        (0.20, 0.85, 0.35, 1) if app.ai_status == "ONLINE" \
                        else (0.15, 0.65, 0.95, 1) if app.ai_status == "OFFLINE" \
                        else (0.85, 0.85, 0.85, 1)
                    font_size: dp(14)
                    size_hint_y: 1

                MDIconButton:
                    icon: "information-outline"
                    theme_icon_color: "Custom"
                    icon_color: app.mm_text
                    pos_hint: {"center_y": 0.5}
                    on_release: app.show_ai_info()

        # ===== Content =====
        ScreenManager:
            id: sm

        # ===== Bottom bar =====
        BoxLayout:
            size_hint_y: None
            height: dp(44)
            padding: dp(8), dp(4)
            canvas.before:
                Color:
                    rgba: app.mm_surface
                Rectangle:
                    pos: self.pos
                    size: self.size

            MDIconButton:
                icon: "home"
                theme_icon_color: "Custom"
                icon_color: app.mm_text
                opacity: 0 if root.ids.sm.current == "home" else 1
                disabled: True if root.ids.sm.current == "home" else False
                on_release: app.open_home()

            Widget:

    # ===== Floating AI button =====
    MDFabButton:
        icon: "robot-outline"
        style: "small"
        md_bg_color: app.mm_primary
        theme_icon_color: "Custom"
        icon_color: (0, 0, 0, 1)
        pos_hint: {"right": 0.97, "y": 0.008}
        on_release: app.open_ai_assistant()


MMRoot:
